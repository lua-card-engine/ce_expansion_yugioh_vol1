# Copy this file to .env and fill in the values. Used by `npm run sync-r2` in tools/.
# Same values as the R2_* GitHub secrets used by .github/workflows/sync-to-r2.yml

# Cloudflare dashboard > R2 object storage > Overview > Account Details
R2_ACCOUNT_ID=
# Cloudflare dashboard > R2 > Manage Account > Account API Tokens (needs Read + Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Name of the R2 bucket that stores the card materials
R2_BUCKET_NAME=card-engine
